{
  "name": "lab-site",
  "description": "The website for Uncle Buck's Laboratory",
  "scripts": {
    "sync": "node scripts/sync-registry.mjs",
    "dev": "npm run sync && npm run tokens && astro dev",
    "build": "npm run sync && npm run tokens && astro build",
    "preview": "astro preview",
    "tokens": "node scripts/build-tokens.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check": "npm run build && npm run test:worker && npm run check:privacy && npm run check:a11y",
    "test:worker": "node scripts/test-worker.mjs",
    "og": "node scripts/og-images.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unclebuckslab/lab-site.git"
  },
  "bugs": {
    "url": "https://github.com/unclebuckslab/lab-site/issues"
  },
  "homepage": "https://github.com/unclebuckslab/lab-site#readme",
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "6.4.8",
    "js-yaml": "4.3.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.65.1",
    "wrangler": "4.166.0"
  },
  "packageManager": "npm@10.9.9"
}
