---
import Base from '../layouts/Base.astro';
import LeadFeature from '../components/LeadFeature.astro';
import WorkRow from '../components/WorkRow.astro';
import { getProjects } from '../lib/projects';

const projects = getProjects();
const lead = projects.find((p) => !p.inLab && !p.retired);
const rest = projects.filter((p) => p !== lead);
const num = (i: number) => String(i + 1).padStart(3, '0');
---
<Base>
  <h1 class="visually-hidden">Uncle Buck's Laboratory</h1>
  <div class="opening">
    <p>A creative research lab: research, analysis and building in public, with AI agents doing the digging and a person checking the work.</p>
    <span class="pending">[VOICE PENDING]</span>
  </div>

  <h2 class="visually-hidden" id="work">Work</h2>
  {lead && <LeadFeature project={lead} number={num(0)} />}
  {rest.length > 0 && (
    <ul class="rows" aria-labelledby="work">
      {rest.map((project, i) => <WorkRow project={project} number={num(i + 1)} />)}
    </ul>
  )}
</Base>
