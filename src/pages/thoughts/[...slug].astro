---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getThoughts, formatDate } from '../../lib/thoughts';

export async function getStaticPaths() {
  const posts = await getThoughts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="post">
    <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/thoughts">Thoughts</a> / {post.data.title}</nav>
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <p class="mono secondary">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time> · Uncle Buck{post.data.draft && ' · Draft'}
      </p>
    </header>
    <div class="post-body"><Content /></div>
  </article>
</Base>
