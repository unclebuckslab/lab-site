---
import Base from '../../layouts/Base.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getProjects } from '../../lib/projects';

const projects = getProjects();
const num = (i: number) => String(i + 1).padStart(3, '0');
---
<Base title="Work" description="Everything Uncle Buck's Laboratory has finished.">
  <div class="page-head">
    <h1>Work</h1>
    <p class="lede">Everything the lab has finished, including work that's no longer updated. <span class="pending">[VOICE PENDING]</span></p>
  </div>
  <ul class="rows" aria-label="Work">
    {projects.map((project, i) => <WorkRow project={project} number={num(i)} />)}
  </ul>
</Base>
