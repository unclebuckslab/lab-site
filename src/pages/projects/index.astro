---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = getProjects();
---
<Base title="Projects" description="Everything in Uncle Buck's Laboratory right now, and where each one stands.">
  <h1>Projects</h1>
  <p class="lede">Everything in the lab right now, and where each one stands. <span class="pending">[VOICE PENDING]</span></p>
  <ul class="cards" aria-label="Projects">
    {projects.map((project) => <ProjectCard project={project} />)}
  </ul>
</Base>
