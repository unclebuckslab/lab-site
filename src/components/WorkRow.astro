---
import { Image } from 'astro:assets';
import Kind from './Kind.astro';
import { statusLabel, type Project } from '../lib/projects';
import { projectPage } from '../data/project-pages';

interface Props { project: Project; number: string }
const { project, number } = Astro.props;
const page = projectPage(project.id);
const cadence = page?.facts.find((f) => f.label === 'Updated')?.value;
---
<li class="row">
  <span class="row-num mono" aria-hidden="true">{number}</span>
  <div class="row-body">
    <Kind type={project.type} />
    <h3><a href={`/projects/${project.id}`}>{project.name}</a></h3>
    <p>{project.summary}</p>
    <p class="mono">{statusLabel(project)}{cadence && !project.retired && !project.inLab && ` · Updated: ${cadence}`}</p>
  </div>
  {page?.tile && (
    <a class="row-thumb" href={`/projects/${project.id}`} tabindex="-1" aria-hidden="true">
      <Image src={page.tile.src} alt="" widths={[200, 400]} sizes="12.5rem" />
    </a>
  )}
</li>
